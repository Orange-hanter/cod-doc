# TLS от Let's Encrypt и прокси на MCP (RFC 29 §3.8, CLO-039).
# /mcp, /api/v1 и /api/sync/v1 — за Bearer-гейтом cod-doc. Остальной /api/*
# (legacy, POST /settings) гейта не имеет и наружу не выходит — 404.
# Веб-UI (миграция 0056) — за OIDC-логином (Pocket ID) и ТОЛЬКО при явном
# COD_DOC_WEB_PUBLIC=1: SessionGate cod-doc включён, лишь когда заданы
# COD_DOC_OIDC_*, а без логина открывать веб нельзя. Нет переменной — 404.
{$COD_DOC_PUBLIC_HOST} {
	encode zstd gzip

	handle /mcp* {
		reverse_proxy cod-doc-mcp:8801 {
			# streamable-http держит ответ открытым — без буферизации.
			flush_interval -1
		}
	}

	handle /api/v1/* {
		reverse_proxy cod-doc:8765
	}

	# Умный remote (RFC 29 §10.9): объекты и снапшоты бывают большими.
	handle /api/sync/v1/* {
		request_body {
			max_size 1GB
		}
		reverse_proxy cod-doc:8765
	}

	# Legacy /api/* (включая POST /settings) — только loopback на узле.
	handle /api/* {
		respond 404
	}

	# Веб за OIDC-логином: маршруты логина, статика, live-обновления и страницы.
	# Дефолт закрытый вдвойне (ревью #282, раунды 2–3): нужен и явный
	# COD_DOC_WEB_PUBLIC=1, и настроенный COD_DOC_OIDC_ISSUER — без обоих веб
	# отвечает 404, потому что SessionGate cod-doc без OIDC-переменных выключен.
	@web_off expression `{env.COD_DOC_WEB_PUBLIC} != "1" || {env.COD_DOC_OIDC_ISSUER} == ""`
	handle /auth/* {
		respond @web_off 404
		reverse_proxy cod-doc:8765
	}
	handle /static/* {
		respond @web_off 404
		reverse_proxy cod-doc:8765
	}
	handle /ws* {
		respond @web_off 404
		reverse_proxy cod-doc:8765
	}
	handle {
		respond @web_off 404
		reverse_proxy cod-doc:8765
	}
}
