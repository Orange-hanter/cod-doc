#!/usr/bin/env bash
# COD-DOC pre-push hook: полный гейт перед пушем.
#
# Точка перехода выбрана намеренно. Pre-commit был бы слишком часто — гейт
# идёт ~2 минуты, а коммитов в ветке десяток. Момент, когда работа уезжает из
# локального дерева наружу, — последний, где красный ещё дёшево чинится.
#
# Запуск не зависит от дисциплины того, кто коммитит: ни человек, ни агент не
# обязаны помнить про гейт и, что важнее, не обязаны о нём отчитываться.
# Зелёный печатает одну строку, красный блокирует пуш и печатает разбор.
#
# Обойти: git push --no-verify, либо SKIP_GATE=1 git push (например, чтобы
# отдать WIP-ветку на чужую машину).
set -uo pipefail

if [[ "${SKIP_GATE:-}" == "1" ]]; then
  echo "⏭  гейт пропущен (SKIP_GATE=1)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
GATE="$REPO_ROOT/scripts/gate.sh"

if [[ ! -x "$GATE" ]]; then
  echo "⚠️  $GATE не найден — пуш пропущен без проверки"
  exit 0
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha> по строке на ref.
# Удаление ветки (local sha из нулей) ничего не привносит в remote — гонять
# на нём двухминутный гейт незачем.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  [[ "$local_sha" =~ ^0+$ ]] || only_deletes=0
done
if [[ $only_deletes -eq 1 ]]; then
  exit 0
fi

"$GATE"
status=$?
if [[ $status -ne 0 ]]; then
  echo
  echo "❌ Пуш отклонён: гейт красный. Почини или обойди — SKIP_GATE=1 git push"
  # ADO-212: до фикса красный гейт из worktree означал, что тесты уже
  # закоммитили в ветку дерево фикстуры, и обход выталкивал его наружу.
  echo "   Перед обходом сверь, что ветку не тронули: git log --oneline -1"
  echo "   и git config core.bare (должно быть false)."
  exit 1
fi
exit 0
