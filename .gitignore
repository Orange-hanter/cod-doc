__pycache__/
*.py[cod]
.Python
build/
dist/
*.egg-info/
.venv/
venv/
# `.venv/` со слэшем ловит только каталог. В worktree общий venv кладут
# симлинком `.venv` — без этой строки он уезжает в индекс вместе с правкой.
.venv
.chroma/
.cod-doc/
.env
*.env
.idea/
.vscode/
.pytest_cache/
.coverage

# COD-DOC
*.pyc

# Local dev tooling
.claude/
.cursor/
.mcp.json
# Plugin MCP manifests ship empty server maps (no stdio spawn). Cursor
# must not launch MCP from the Claude-plugin bridge; hosts use
# `cod-doc connect install`. Keep the files in git so a missing map is
# not mistaken for "use the default locator".
!plugins/*/.mcp.json
!plugins/*/mcp.json
# ADO-020: anchored. Unanchored `models/` also matched `cod_doc/infra/models/`,
# so five ORM modules that `cod_doc.infra.models.__init__` imports were never
# committed — a fresh clone could not import the package at all.
/models/

# Local playwright scripts
.cod-doc-playwright-*.py
.cod-doc-pw-*.py
.playwright-mcp/

# macOS
.DS_Store
