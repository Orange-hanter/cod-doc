{
  "_doc": "Do not copy this by hand. Run `cod-doc connect install --client claude-code` (or `--client all`). The installer writes an absolute command. Plugin MCP is optional and only for Claude Code.",
  "mcpServers": {
    "cod-doc": {
      "type": "stdio",
      "command": "/ABS/PATH/TO/.venv/bin/cod-doc-mcp",
      "args": ["--profile", "standard"]
    }
  }
}
