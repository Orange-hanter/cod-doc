  local -a cmds
  cmds=(
    'adapter:Manage LLM adapters (built-in + external plugins).'
    'adr:Manage Architecture Decision Records (new / list / show / supersede…'
    'agent:Управление агентом.'
    'audit:Audit document frontmatter (FM-* rules) and optionally drift (DR-00…'
    'completion:Shell-completion для cod-doc.'
    'ctx:Контекст проекта для внешних потребителей (docs / drift / search).'
    'doc:Manage documents (create, rename, export, drift, import).'
    'embed:Провайдер эмбеддингов; статус, живая проверка, каталог, сброс индек…'
    'finding:Inspect and manage external findings.'
    'hash:Утилиты хэширования.'
    'hub:Управление глобальной hub-БД (мультипроектный реестр).'
    'import:Импорт документации/задач из репозитория проекта.'
    'ingest:Ingest external findings (ai-review, ZAIrgRush, routines).'
    'link:Manage document links (list, sync, verify).'
    'mcp:Запустить MCP-сервер поверх COD-DOC.'
    'obligation:Documented obligations for the structure protocol.'
    'plan:Inspect and query plans (progress, ready tasks, audit, export).'
    'project:Управление проектами.'
    'reindex:Rebuild repo-level indexes (files / symbols / imports).'
    'revision:Inspect and revert revision history.'
    'routine:Inspect and run routines (scheduled health checks).'
    'scenario:Author test scenarios and project them into docs/system/scenarios/.'
    'search:Search tasks / docs / stories / ADRs for QUERY (FTS5).'
    'serve:Запустить REST API сервер (production).'
