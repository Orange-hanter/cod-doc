  _describe -t cod-doc-commands 'cod-doc command' cmds
}

(( $+functions[_cod_doc_adapter] )) || _cod_doc_adapter() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args
  _arguments -C -s -S \
    '(- *)--help[Show this message and exit.]' \
    '1: :_cod_doc_adapter_commands' \
    '*:: :->cod_doc_adapter_cmd' && ret=0

  case $state in
    (cod_doc_adapter_cmd)
      curcontext="${curcontext%:*:*}:cod-doc-adapter-$words[1]:"
